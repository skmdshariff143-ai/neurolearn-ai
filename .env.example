# Explicit mode. No silent fallback; fixture responses are labelled.
AI_PROVIDER=fixture
ALLOW_DEMO_MODE=true
NEBIUS_API_KEY=
# Copy an available NVIDIA Nemotron model ID from your Token Factory console.
NEBIUS_MODEL=
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=neurolearn-ai
# Optional: set only when your LangSmith region/workspace requires these.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# Hosted PostgreSQL is opt-in; no database is created automatically.
PERSISTENCE_PROVIDER=browser
DATABASE_URL=
RATE_LIMIT_BACKEND=memory
# Production live calls require postgres request budgets and both values below.
# Generate random values locally; never put them in NEXT_PUBLIC variables.
SESSION_SIGNING_SECRET=
LIVE_AI_ACCESS_CODE=
